# Template for the `.env` file `op run` resolves. Copy to `.env` and adjust the plain values;
# leave the `op://` references as they are. `.env` is gitignored and must never hold a secret
# value - only a reference to one.
#
#   op run --env-file .env -- overmind start            # dev bring-up
#   op run --env-file .env -- npm run setup:aidbox      # idempotent Aidbox setup
#
# The secret-bearing entries live in 1Password item "Smart Forms Health Links" in the
# "Work Agent" vault, whose fields are created by the first `setup:aidbox` run.

# ----------------------------------------------------------------------------------------
# The BFF process (server/config.ts)
# ----------------------------------------------------------------------------------------

# Origin the app is served from. In development this is the BFF, not the Vite dev server.
APP_ORIGIN=http://localhost:3000
PORT=3000

# SQLite database holding sessions and invitations.
SQLITE_PATH=./data/links.sqlite

# JSON array of permitted FHIR servers and the credentials registered with each. Secret-bearing
# fields inside it hold `env:VARIABLE_NAME` references, not values.
ISSUER_REGISTRY_PATH=./config/issuers.json

# Signs the `shl_session` cookie. At least 32 characters.
SESSION_COOKIE_SECRET=op://Work Agent/Smart Forms Health Links/session cookie secret

# Which browser origins may call the public `/shl` routes (manifests, the write target, write
# slots). Unset or `*` means any origin, which is what a link meant for any receiver needs.
# Otherwise a comma-separated list of exact origins, such as https://patient-app.example.com.
# SHL_CORS_ORIGINS=*

# ----------------------------------------------------------------------------------------
# Credentials the issuer registry references by name
# ----------------------------------------------------------------------------------------

# The confidential launch client's secret, as generated by `setup:aidbox`. Leave this commented
# out until that first run has printed one: a variable set to the empty string is treated as
# absent, but commenting it out says so more plainly.
LAUNCH_CLIENT_SECRET=op://Work Agent/Smart Forms Health Links/launch client secret

# The SMART Backend Services RS384 signing key, as generated by `setup:aidbox`. One line of
# JWK JSON, private members included.
BACKEND_PRIVATE_JWK=op://Work Agent/Smart Forms Health Links/backend private jwk

# ----------------------------------------------------------------------------------------
# The Aidbox setup script (ops/aidboxSetup.ts)
# ----------------------------------------------------------------------------------------

# Suffix appended to the ids this environment registers its two OAuth clients under.
#
# One Aidbox instance serves more than one environment, and a Client holds exactly one
# redirect_uri and one key location - so the environments cannot share a registration. Whoever
# ran setup last would own it, and everybody else's sign-in would fail at the authorize step.
#
# You do not have to set this. It defaults to "-local" for a loopback APP_ORIGIN and to nothing
# otherwise, so a developer's machine gets its own clients without being told to, and the
# deployment keeps the unsuffixed ids it already holds. Set it only for a third environment.
#
# Setting it to an *empty* value asks for the unsuffixed, deployed ids. That is refused when
# APP_ORIGIN is a loopback host, and is what .env.deploy uses to defend against a shell that
# sourced this file first.
#
# Whatever this resolves to must match the clientIds in the issuer registry above.
CLIENT_ID_SUFFIX=-local

AIDBOX_BASE_URL=https://sczsqtqcgi.aidbox.app

# Operator credentials, used with HTTP Basic to write Clients, AccessPolicies and demo data.
# Created by hand once per instance - see "Creating the operator client" in
# docs/aidbox-validation.md. Not used by the running app, only by the setup script.
AIDBOX_CLIENT_ID=op://Work Agent/Smart Forms Health Links Aidbox Operator/username
AIDBOX_CLIENT_SECRET=op://Work Agent/Smart Forms Health Links Aidbox Operator/password

# Grant lifetime in seconds. Registered verbatim as the clients' `access_token_expiration`,
# which this Aidbox build interprets in seconds. Optional; defaults to 3600.
GRANT_TTL_SECONDS=3600

# ----------------------------------------------------------------------------------------
# The Aidbox user the Playwright suite logs in as. The password is *input*, not generated:
# choose one before the first setup run, which fails without it.
# ----------------------------------------------------------------------------------------

AIDBOX_E2E_USER_ID=e2e-demo
AIDBOX_E2E_USER_EMAIL=e2e-demo@example.org
AIDBOX_E2E_USER_PASSWORD=op://Work Agent/Smart Forms Health Links/e2e user password
