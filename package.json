{
  "name": "smart-forms-health-links",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --format=esm --platform=node --target=node22 --packages=external --alias:@=./src --outfile=dist-server/index.mjs --log-level=warning",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:duplication": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "setup:aidbox": "tsx ops/aidboxSetup.ts",
    "check:roundtrip": "esbuild scripts/roundtrip.ts --bundle --format=esm --platform=node --target=node22 --alias:@=./src --outfile=node_modules/.cache/roundtrip.mjs --log-level=warning && node node_modules/.cache/roundtrip.mjs",
    "check:e2e": "esbuild scripts/e2eLink.ts --bundle --format=esm --platform=node --target=node22 --alias:@=./src --outfile=node_modules/.cache/e2e.mjs --log-level=warning && node node_modules/.cache/e2e.mjs",
    "check:e2e-shl": "esbuild scripts/e2eShl.ts --bundle --format=esm --platform=node --target=node22 --alias:@=./src --outfile=node_modules/.cache/e2e-shl.mjs --log-level=warning && node node_modules/.cache/e2e-shl.mjs"
  },
  "dependencies": {
    "@aehrc/sdc-populate": "^4.7.1",
    "@aehrc/sdc-template-extract": "^1.0.15",
    "@aehrc/smart-forms-renderer": "^1.4.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.90.5",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "fastify": "^5.12.1",
    "jose": "^6.2.9",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/fhir": "^0.0.41",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.11.0",
    "jscpd": "^5.0.16",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.11"
  }
}
