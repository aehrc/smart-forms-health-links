{
  "resourceType": "Questionnaire",
  "id": "NewPatientRegistration",
  "extension": [
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        {
          "url": "name",
          "valueCoding": {
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext",
            "code": "patient"
          }
        },
        {
          "url": "type",
          "valueCode": "Patient"
        },
        {
          "url": "description",
          "valueString": "The person filling in the form, as their own health record app holds them"
        }
      ]
    }
  ],
  "item": [
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-collapsible",
          "valueCode": "default-open"
        }
      ],
      "linkId": "about-you",
      "text": "About you",
      "type": "group",
      "item": [
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "(%patient.name.where(use = 'official') | %patient.name).first().given.join(' ')"
              }
            }
          ],
          "linkId": "name-given",
          "text": "Given name(s)",
          "type": "string",
          "definition": "http://hl7.org/fhir/StructureDefinition/Patient#Patient.name.given"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "(%patient.name.where(use = 'official') | %patient.name).first().family"
              }
            }
          ],
          "linkId": "name-family",
          "text": "Family name",
          "type": "string",
          "definition": "http://hl7.org/fhir/StructureDefinition/Patient#Patient.name.family",
          "required": true
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.name.where(use = 'usual').given.first()"
              }
            }
          ],
          "linkId": "name-preferred",
          "text": "Preferred name, if different",
          "type": "string"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.birthDate"
              }
            }
          ],
          "linkId": "birth-date",
          "text": "Date of birth",
          "type": "date",
          "definition": "http://hl7.org/fhir/StructureDefinition/Patient#Patient.birthDate"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.gender"
              }
            }
          ],
          "linkId": "gender",
          "text": "Gender",
          "type": "choice",
          "definition": "http://hl7.org/fhir/StructureDefinition/Patient#Patient.gender",
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://hl7.org/fhir/administrative-gender",
                "code": "female",
                "display": "Female"
              }
            },
            {
              "valueCoding": {
                "system": "http://hl7.org/fhir/administrative-gender",
                "code": "male",
                "display": "Male"
              }
            },
            {
              "valueCoding": {
                "system": "http://hl7.org/fhir/administrative-gender",
                "code": "other",
                "display": "Other"
              }
            },
            {
              "valueCoding": {
                "system": "http://hl7.org/fhir/administrative-gender",
                "code": "unknown",
                "display": "Prefer not to say"
              }
            }
          ]
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "drop-down"
                  }
                ]
              }
            }
          ],
          "linkId": "indigenous-status",
          "text": "Are you of Aboriginal or Torres Strait Islander origin?",
          "type": "choice",
          "answerValueSet": "https://healthterminologies.gov.au/fhir/ValueSet/australian-indigenous-status-1"
        },
        {
          "linkId": "language-at-home",
          "text": "Main language spoken at home",
          "type": "string"
        },
        {
          "linkId": "interpreter-needed",
          "text": "Would you like an interpreter?",
          "type": "boolean"
        }
      ]
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-collapsible",
          "valueCode": "default-closed"
        }
      ],
      "linkId": "contact",
      "text": "How we can reach you",
      "type": "group",
      "item": [
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "(%patient.address.where(use = 'home') | %patient.address).first().line.join('\\n')"
              }
            }
          ],
          "linkId": "address-line",
          "text": "Street address",
          "type": "text"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "(%patient.address.where(use = 'home') | %patient.address).first().city"
              }
            }
          ],
          "linkId": "address-suburb",
          "text": "Suburb",
          "type": "string"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "drop-down"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "(%patient.address.where(use = 'home') | %patient.address).first().state"
              }
            }
          ],
          "linkId": "address-state",
          "text": "State or territory",
          "type": "choice",
          "answerValueSet": "https://healthterminologies.gov.au/fhir/ValueSet/australian-states-territories-2"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/regex",
              "valueString": "matches('^[0-9]{4}$')"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "####"
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "(%patient.address.where(use = 'home') | %patient.address).first().postalCode"
              }
            }
          ],
          "linkId": "address-postcode",
          "text": "Postcode",
          "type": "string",
          "maxLength": 4
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.telecom.where(system = 'phone' and use = 'mobile').value.first()"
              }
            }
          ],
          "linkId": "phone-mobile",
          "text": "Mobile number",
          "type": "string"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.telecom.where(system = 'phone').exclude(%patient.telecom.where(system = 'phone' and use = 'mobile')).value.first()"
              }
            }
          ],
          "linkId": "phone-other",
          "text": "Other phone number",
          "type": "string"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.telecom.where(system = 'email').value.first()"
              }
            }
          ],
          "linkId": "email",
          "text": "Email address",
          "type": "string"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            }
          ],
          "linkId": "contact-preference",
          "text": "How would you prefer we contact you?",
          "type": "choice",
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://smartforms.csiro.au/CodeSystem/new-patient-registration",
                "code": "sms",
                "display": "Text message"
              }
            },
            {
              "valueCoding": {
                "system": "http://smartforms.csiro.au/CodeSystem/new-patient-registration",
                "code": "phone",
                "display": "Phone call"
              }
            },
            {
              "valueCoding": {
                "system": "http://smartforms.csiro.au/CodeSystem/new-patient-registration",
                "code": "email",
                "display": "Email"
              }
            }
          ]
        }
      ]
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-collapsible",
          "valueCode": "default-closed"
        }
      ],
      "linkId": "medicare-and-concessions",
      "text": "Medicare and concessions",
      "type": "group",
      "item": [
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-displayCategory",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-display-category",
                    "code": "instructions"
                  }
                ]
              }
            }
          ],
          "linkId": "medicare-guidance",
          "text": "These are used for billing only. Bring your cards with you - reception will check them against what you have written here.",
          "type": "display"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/regex",
              "valueString": "matches('^[0-9]{10}$')"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "##########"
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.identifier.where(system = 'http://ns.electronichealth.net.au/id/medicare-number').value.first().substring(0, 10)"
              }
            }
          ],
          "linkId": "medicare-number",
          "text": "Medicare number",
          "type": "string",
          "maxLength": 10
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/regex",
              "valueString": "matches('^[0-9]$')"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "#"
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.identifier.where(system = 'http://ns.electronichealth.net.au/id/medicare-number').value.first().substring(10, 1)"
              }
            }
          ],
          "linkId": "medicare-irn",
          "text": "Individual reference number (the number beside your name on the card)",
          "type": "string",
          "maxLength": 1
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "MM/YYYY"
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.identifier.where(system = 'http://ns.electronichealth.net.au/id/medicare-number').period.end.first().toString().select(substring(5, 2) + '/' + substring(0, 4))"
              }
            }
          ],
          "linkId": "medicare-expiry",
          "text": "Card valid to",
          "type": "string"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.identifier.where(system = 'http://ns.electronichealth.net.au/id/dva').exists()"
              }
            }
          ],
          "linkId": "has-dva",
          "text": "Do you have a DVA card?",
          "type": "boolean"
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%patient.identifier.where(system = 'http://ns.electronichealth.net.au/id/dva').value.first()"
              }
            }
          ],
          "linkId": "dva-number",
          "text": "DVA file number",
          "type": "string",
          "enableWhen": [
            {
              "question": "has-dva",
              "operator": "=",
              "answerBoolean": true
            }
          ]
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            }
          ],
          "linkId": "dva-card-colour",
          "text": "DVA card colour",
          "type": "choice",
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://smartforms.csiro.au/CodeSystem/new-patient-registration",
                "code": "gold",
                "display": "Gold"
              }
            },
            {
              "valueCoding": {
                "system": "http://smartforms.csiro.au/CodeSystem/new-patient-registration",
                "code": "white",
                "display": "White"
              }
            },
            {
              "valueCoding": {
                "system": "http://smartforms.csiro.au/CodeSystem/new-patient-registration",
                "code": "orange",
                "display": "Orange"
              }
            }
          ],
          "enableWhen": [
            {
              "question": "has-dva",
              "operator": "=",
              "answerBoolean": true
            }
          ]
        },
        {
          "linkId": "has-concession-card",
          "text": "Do you have a pensioner or health care card?",
          "type": "boolean"
        },
        {
          "linkId": "concession-number",
          "text": "Concession card number",
          "type": "string",
          "enableWhen": [
            {
              "question": "has-concession-card",
              "operator": "=",
              "answerBoolean": true
            }
          ]
        }
      ]
    },
    {
      "extension": [
